# Build outputs — regenerated by the build, never committed.
frontend/node_modules/
frontend/dist/
backend/java-gateway/target/
backend/csharp-api/bin/
backend/csharp-api/obj/
backend/cpp-secretvault/secretvault
backend/python-api/staticfiles/
backend/logs/

# Local data and caches.
__pycache__/
*.pyc
*.sqlite3
backend/python-api/media/*
!backend/python-api/media/.gitkeep

# Anything holding a real secret.
.env
*.vault
