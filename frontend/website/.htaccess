# ---------------------------------------------------------------------------
# Apache settings for shared hosting (cPanel, Hostinger, GoDaddy, LiteSpeed).
#
# Everything here is optional. Every directive is wrapped in <IfModule>, so a
# server missing any of these modules simply ignores that block instead of
# failing. An unguarded directive that a server does not recognise makes Apache
# answer HTTP 500 for EVERY page, which looks exactly like a blank website —
# that is why the guards matter.
#
# If anything still goes wrong: DELETE THIS FILE. The website works completely
# without it. You only lose the custom 404 page and some caching.
# ---------------------------------------------------------------------------

# Serve index.html for the bare domain.
<IfModule mod_dir.c>
  DirectoryIndex index.html index.htm
</IfModule>

# Show our own page instead of the host's default "Not Found".
ErrorDocument 404 /404.html

# Compress text so pages load faster on a slow connection.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript image/svg+xml
</IfModule>

# Let browsers keep the design files, but always re-check the pages themselves.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>

# The Admin Panel publishes content.js. Caching it for a week would mean an
# edit did not show up for a week, so this one file always revalidates.
<Files "content.js">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
  <IfModule mod_expires.c>
    ExpiresDefault "access plus 0 seconds"
  </IfModule>
</Files>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Make sure SVG images are served with the right type on older servers.
<IfModule mod_mime.c>
  AddType image/svg+xml .svg
</IfModule>
