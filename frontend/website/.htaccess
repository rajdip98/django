# Apache configuration for shared hosting (cPanel, Hostinger, GoDaddy and the like).
# Upload this file together with the pages. If your host runs nginx instead, it is
# ignored harmlessly — ask your host to set a 404 page and compression there.

# Serve index.html for the bare domain.
DirectoryIndex index.html

# Show our own page instead of the host's default 404.
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Pages change when the office edits them, so keep those fresh.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never serve the working files if they are uploaded by accident.
<FilesMatch "\.(md|py|json|lock|yml|yaml)$">
  Require all denied
</FilesMatch>
