# Apache / cPanel shared hosting configuration for the India Census 2026-27 app.
#
# The app uses hash routing, so no rewrite rules are needed for deep links —
# this file only sets correct MIME types, compression and caching.

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType application/javascript .js
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed asset filenames change whenever the content changes, so they are safe
  # to cache for a long time.
  <FilesMatch "\.(js|css|png|jpg|jpeg|svg|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The shell and the service worker must always be revalidated, otherwise a
  # published update would never reach installed devices.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Serve index.html for a bare directory request.
DirectoryIndex index.html
