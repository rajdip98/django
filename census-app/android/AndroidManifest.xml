<?xml version="1.0" encoding="utf-8"?>
<!--
  India Census 2026-27 — Android wrapper.

  A single Activity hosting a WebView that serves the built PWA from the APK's
  own assets over a virtual https origin. Everything ships inside the package,
  so the app installs and runs with no server and no network.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.rajdip98.census2026"
    android:versionCode="1"
    android:versionName="1.0.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="33" />

    <!-- Only needed to reach a census server; the app is fully usable offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Geo-tagging households. Requested at runtime, only when the form asks. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- CAMERA is deliberately NOT declared: the photo step hands off to the
         device camera app through an intent, which needs no permission here and
         spares the enumerator an extra prompt. -->
    <!-- targetSdk 30+ hides other packages by default; without this the app
         cannot see that a camera exists to offer it for the house photograph. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/CensusTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands exported CSV/JSON files to a share target without needing
             storage permissions. Not exported: access is granted per-URI. -->
        <provider
            android:name=".ExportProvider"
            android:authorities="io.github.rajdip98.census2026.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
