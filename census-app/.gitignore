# Collected data and secrets — never commit these
backend/data/
# The Android signing key. Android only accepts an update signed with the same
# key, so back this up somewhere safe — but never in version control.
android/keystore/
*.env
!.env.example
.secret_key

# Test artefacts
frontend/e2e-*.png

# Tooling
.pytest_cache/
.DS_Store
*.log
