# India Census 2026-27 — backend configuration.
# Copy to .env and load it however your host prefers (docker compose --env-file,
# systemd EnvironmentFile, cPanel "Environment variables", etc.).
#
# Every value below has a working default; the app starts with none of them set.

# --- Security --------------------------------------------------------------
# Long random string. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# If unset, one is generated and stored in DATA_DIR/.secret_key.
SECRET_KEY=

# Administrator password for the admin panel. CHANGE THIS before going live.
ADMIN_PASSWORD=rajdip100@
# Alternatively store only the hash (preferred). Generate with:
#   python3 -c "from app.security import hash_password; print(hash_password('your-password'))"
# When set, ADMIN_PASSWORD is ignored.
ADMIN_PASSWORD_HASH=

# How long a login stays valid, in hours (default 336 = 14 days).
TOKEN_TTL_HOURS=336

# Set to false once all enumerators and supervisors exist in the admin panel;
# unknown mobile numbers are then refused at login.
ALLOW_SELF_REGISTRATION=true

# --- Storage ---------------------------------------------------------------
# Leave MONGODB_URI empty to use the built-in JSON store (no database needed).
MONGODB_URI=
MONGODB_DB=india_census_2026

# Where the embedded store, and the generated secret key, are written.
DATA_DIR=./data

# --- Web -------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Use your real domain in
# production, e.g. https://census.example.in
CORS_ORIGINS=*

# Path to the built frontend. Auto-detected as backend/static or frontend/dist.
STATIC_DIR=

# --- OTP -------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_HOUR=8

# --- SMS (optional) --------------------------------------------------------
# Without all three, the OTP is returned in the API response instead of being
# texted — fine for testing, not for production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- AI (optional) ---------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Leaving these blank keeps all
# validation on-device, which is the privacy-preserving default.
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI:  https://api.openai.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=25
